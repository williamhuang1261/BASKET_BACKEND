# Copy to loadtest/.loadtest.server.env (gitignored) before running the
# server for a local load test. Firebase/GoogleAI values are throwaway
# local values, not real credentials - the load test only exercises
# /items/search and /items/autocomplete, which never call either service
# on a successful path (embeddings failing is the expected, already-handled
# fallback to full-text search; no request in the load test touches
# Firebase-authenticated routes).
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0
BASKET_SERVER_HOST=localhost
BASKET_JWT_PRIVATE_KEY=loadtest-local-dummy-jwt-key
BASKET_DB_CONNECTION_STRING=mongodb://localhost:27777/basket_loadtest?directConnection=true

BASKET_FIREBASE_TYPE=service_account
BASKET_FIREBASE_PROJECT_ID=loadtest-local
BASKET_FIREBASE_PRIVATE_KEY_ID=loadtest-local
BASKET_FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUM\nMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMYDUMMY==\n-----END RSA PRIVATE KEY-----\n"
BASKET_FIREBASE_CLIENT_EMAIL=loadtest-local@example.com
BASKET_FIREBASE_CLIENT_ID=loadtest-local
BASKET_FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
BASKET_FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
BASKET_FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
BASKET_FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/loadtest-local
BASKET_FIREBASE_UNIVERSE_DOMAIN=googleapis.com

BASKET_GOOGLEAI_PROJECT_ID=loadtest-local
BASKET_GOOGLEAI_LOCATION=us-central1
